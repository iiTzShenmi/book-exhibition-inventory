# Safe deployment template. Replace every placeholder outside version control.
APP_ENV=production
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/EXIS_DATABASE
REDIS_URL=redis://HOST:6379/0
FLASK_SECRET_KEY=REPLACE_WITH_A_HIGH_ENTROPY_SECRET
INVITE_CODE_PEPPER=REPLACE_WITH_AN_INDEPENDENT_HIGH_ENTROPY_SECRET
ADMIN_PASSWORD_HASH=REPLACE_WITH_A_WERKZEUG_PASSWORD_HASH
ADMIN_INVITE_TTL_HOURS=72
SESSION_COOKIE_SECURE=1
TRUSTED_HOSTS=example.com,www.example.com
EXIS_AUTO_INIT=0
EXIS_REQUEST_SCHEMA_CHECK=0

# Keep bootstrap disabled after initial recovery setup.
# EXIS_ENABLE_ADMIN_BOOTSTRAP=1
